{
  "name": "dsh-lightweight-wallpaper",
  "version": "0.1.1",
  "type": "module",
  "description": "Lightweight wallpaper and font plugin for DeepSeek Harness: Bing daily, Wikimedia art, Cleveland CC0, 10wallpaper, and local upload, with paged browsing, recent-used history, cache management, system font pickers for the interface, code and terminal, a small cached host proxy and a thumbnail cache.",
  "license": "MIT",
  "author": "KHWLGH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KHWLGH/dsh-lightweight-wallpaper.git"
  },
  "homepage": "https://github.com/KHWLGH/dsh-lightweight-wallpaper#readme",
  "bugs": {
    "url": "https://github.com/KHWLGH/dsh-lightweight-wallpaper/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "wallpaper",
    "font",
    "bing",
    "10wallpaper"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "check": "node tools/host-smoke.mjs && node tools/client-contract.mjs",
    "prepublishOnly": "npm run check"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
