{
  "name": "dsh-lightweight-wallpaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight wallpaper plugin for DeepSeek Harness: Bing daily, Wikimedia art, Cleveland CC0, and local upload, with paged browsing, recent-used history, cache management, a small cached host proxy and a thumbnail cache.",
  "license": "MIT",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "check": "node tools/host-smoke.mjs && node tools/client-contract.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
